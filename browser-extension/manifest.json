{
  "manifest_version": 3,
  "name": "DMN Matrix Preview for Dify 1.11.1",
  "version": "0.4.3",
  "description": "Read-only DMN preview for legacy and hu8627 JSON/XML decision tools. Activate on this tab only.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Enable DMN matrix on this tab"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
